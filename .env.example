DATABASE_URL=postgresql://user:password@localhost:5432/cendekia
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini

# Google OAuth 2.0 (required for the primary "Continue with Google" login)
# Create an OAuth 2.0 Web application client in Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an Authorized redirect URI in Google Cloud Console.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used to sign session cookies and hash legacy OTP codes. Use a unique random secret (32+ chars) in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional only if you intentionally keep using the legacy email OTP API endpoints.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=Explorin <you@gmail.com>

# Optional OCR fallback for scanned PDFs (Tesseract language codes).
# Training data is downloaded on first use; allow outbound access to the Tesseract data CDN.
PDF_OCR_LANGS=eng+ind
