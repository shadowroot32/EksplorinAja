# ==============================================================================
# Cendekia.ai - Environment Configuration Template
# Salin berkas ini ke `.env` dan sesuaikan nilainya dengan konfigurasi server Anda.
# ==============================================================================

# [1] LLM Provider Configuration (OpenAI-compatible, Ollama, Local Proxy, etc.)
LLM_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_model_name

# [2] Server Host & Port
HOST=0.0.0.0
PORT=8000

# [3] SMTP Email Configuration (Untuk pengiriman kode OTP verifikasi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password

# [4] Security & Session
SESSION_SECRET_KEY=generate_a_random_32_char_secret_here
