# Non-secret production URL settings for EksplorinAja.
# Copy these values into the actual application host environment after custom domain routing is configured. If using Cloudflare Pages, use its variables; if using a Tunnel, set the variables on the app server/PC.
NEXT_PUBLIC_APP_URL=https://eksplorinaja.com
GOOGLE_REDIRECT_URI=https://eksplorinaja.com/api/auth/google/callback

# Register both values in the Google Cloud OAuth Web Client:
# Authorized JavaScript origins: https://eksplorinaja.com
# Authorized redirect URIs: https://eksplorinaja.com/api/auth/google/callback

# Configure secrets separately in Cloudflare; never commit them:
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# JWT_SECRET=...
# DATABASE_URL=...
# LLM_API_KEY=...
# SMTP_FROM=EksplorinAja <verified-sender@example.com>

# This is a template only. It does not configure DNS, buy the domain, or deploy the app.